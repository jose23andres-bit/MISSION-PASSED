# Entorno DEVNET: rama devnet, red de pruebas (sin dinero real). Solo valores públicos (todo VITE_* lo ve cualquier visitante).
# Nunca poner claves, semillas ni tokens aquí; el escáner de secretos y la guarda de seguridad lo bloquean.
SITE_BASE_PATH=/MISSION-PASSED
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_TOKEN_LAUNCH_AT=2026-11-15T19:00:00Z
VITE_LAUNCHPOOL_DEPOSIT_START=2026-11-15T19:00:00Z
VITE_LAUNCHPOOL_RAISE_GOAL_SOL=250
VITE_TREASURY_WALLET=4hqDqmWYnN1N2VJHfCanh5AAFJMBeZGUV31F4pTxcXnj
# Preventa: wallet pública que recibe los pagos. Vacía = botón de pago desactivado.
VITE_PRESALE_WALLET=
VITE_PRESALE_TIERS=0:0.0004,100:0.001,200:0.005
VITE_PRESALE_END=2026-11-15T19:00:00Z
